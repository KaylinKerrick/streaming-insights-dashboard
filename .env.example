# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True

# Leave DATABASE_URL blank to use SQLite during development.
# Set it to a postgres:// URL when switching to PostgreSQL.
DATABASE_URL=

# Obtain a TMDB API key from https://developer.themoviedb.org/
TMDB_API_KEY=
